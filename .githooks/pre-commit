#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "[pre-commit] Generating okay/okay.hpp..."
python scripts/generate_okay_header.py --repo-root "$REPO_ROOT"

echo "[pre-commit] Checking source formatting..."

if ! bash scripts/format.sh --check; then
    echo ""
    echo "[pre-commit] ERROR: Some files are not formatted properly."
    echo "[pre-commit] Please run:"
    echo "    ./scripts/format.sh"
    echo ""
    exit 1
fi

echo "[pre-commit] Checking for license headers..."

if ! python scripts/okay_headers.py okay --check; then
    echo ""
    echo "[pre-commit] ERROR: Some files have missing or outdated license headers."
    echo "[pre-commit] Please run:"
    echo "    python scripts/okay_headers.py okay"
    echo ""
    exit 1
fi


# echo "[pre-commit] Verifying that demo compiles..."

